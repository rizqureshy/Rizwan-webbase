---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmoothScroll from "../components/react/SmoothScroll.tsx";
import Reveal from "../components/react/Reveal.tsx";
import PageHeader from "../components/PageHeader.astro";
import MagneticButton from "../components/react/MagneticButton.tsx";
import { pillars, site } from "../lib/site";

const formats = [
  "Keynotes",
  "Executive briefings",
  "Panels and fireside chats",
  "Workshops for leadership teams",
];
---

<BaseLayout
  title="Speaking"
  description="Rizwan Qureshy speaks on responsible AI, sales enablement, and scaling enterprise AI adoption for executive audiences and industry events."
>
  <SmoothScroll client:load />

  <PageHeader
    eyebrow="Speaking"
    title="Talks that make AI strategy land with the people who decide."
    intro="I speak to executive audiences, go-to-market teams, and industry events about adopting AI responsibly and turning it into real business impact."
  />

  <!-- Topics from the pillars -->
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8">
    <Reveal client:visible>
      <h2 class="text-2xl font-semibold md:text-3xl">Talk topics</h2>
      <p class="mt-3 max-w-xl text-text-muted">
        Each can be tailored to your audience, from board level strategy to
        practitioner workshops.
      </p>
    </Reveal>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p, i) => (
          <Reveal client:visible delay={i * 0.06} as="li">
            <div class="glass h-full rounded-[var(--radius-lg)] p-6">
              <span class="font-mono text-xs text-text-faint">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">
                {p.summary}
              </p>
            </div>
          </Reveal>
        ))
      }
    </ul>
  </section>

  <!-- Speaker bio + formats -->
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8">
    <div class="grid gap-10 lg:grid-cols-2">
      <Reveal client:visible>
        <div class="glass h-full rounded-[var(--radius-lg)] p-7">
          <h2 class="text-xl font-semibold">Speaker bio</h2>
          <p class="mt-4 leading-relaxed text-text-muted">
            Rizwan Qureshy is an AI strategist and leader at Equinix, where he is
            Product Owner of ACE, the company's first generative AI based digital
            sales assistant. He is the author of Think Before You AI and
            contributes to Gartner thought leadership. He holds certifications
            from Harvard, MIT, and Texas McCombs, and is a Certified AI
            Governance Professional and IEEE CertifAIEd AI Ethicist.
          </p>
          <p class="mt-4 text-sm text-text-faint">
            Short and long form bios, plus a headshot, are available on request.
          </p>
        </div>
      </Reveal>

      <Reveal client:visible delay={0.05}>
        <div class="glass h-full rounded-[var(--radius-lg)] p-7">
          <h2 class="text-xl font-semibold">Formats</h2>
          <ul class="mt-5 space-y-3">
            {
              formats.map((f) => (
                <li class="flex items-center gap-3 text-text-muted">
                  <span
                    class="h-1.5 w-1.5 rounded-full bg-azure-400"
                    aria-hidden="true"
                  />
                  {f}
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <MagneticButton
              client:visible
              href={`mailto:${site.email}?subject=Speaking inquiry`}
              external={false}
            >
              Invite me to speak
            </MagneticButton>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmoothScroll from "../components/react/SmoothScroll.tsx";
import Reveal from "../components/react/Reveal.tsx";
import Hero from "../components/sections/Hero.astro";
import { pillars } from "../lib/site";
---

<BaseLayout>
  <!-- Lenis smooth scroll for the whole page -->
  <SmoothScroll client:load />

  <Hero />

  <!--
    SELECTED WORK (stub, intentionally empty).
    NDA: do not populate with internal Equinix tools. When genericized,
    NDA-safe case studies exist, build them as cards here.
    <section id="work" aria-label="Selected work"> ... </section>
  -->

  <!-- What I help with: the five pillars (preview of full Home build) -->
  <section
    class="mx-auto max-w-[var(--max-content)] px-5 py-28 md:px-8"
    aria-label="What I help with"
  >
    <Reveal client:visible>
      <p class="text-sm uppercase tracking-[0.2em] text-azure-400">
        What I help with
      </p>
      <h2 class="mt-4 max-w-2xl text-2xl font-semibold md:text-3xl">
        Five ideas that shape how I think about enterprise AI.
      </h2>
    </Reveal>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p, i) => (
          <Reveal client:visible delay={i * 0.06} as="li">
            <article class="glass group h-full rounded-[var(--radius-lg)] p-6 transition-colors hover:border-azure-500/50">
              <span class="text-xs font-mono text-text-faint">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">
                {p.summary}
              </p>
            </article>
          </Reveal>
        ))
      }
    </ul>
  </section>
</BaseLayout>

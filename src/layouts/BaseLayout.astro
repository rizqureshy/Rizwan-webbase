---
import "../styles/global.css";
import Nav from "../components/nav/Nav.astro";
import Footer from "../components/nav/Footer.astro";
import { site, social, book } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /* Path to an OG image in /public/og, or leave default. */
  ogImage?: string;
  /* Set true on article pages to add Article structured data. */
  article?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = "/og/default.png",
  article = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// JSON-LD: Person + Book. Verified facts only.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  description: site.description,
  url: site.url,
  sameAs: [social.linkedin, social.amazon],
  worksFor: { "@type": "Organization", name: "Equinix" },
  knowsAbout: [
    "Artificial Intelligence strategy",
    "AI governance",
    "Sales enablement",
    "Responsible AI",
    "Enterprise AI adoption",
  ],
};

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: book.title,
  about: book.subtitle,
  author: { "@type": "Person", name: site.name },
  url: book.buyUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: variable Inter (UI) and Newsreader (article serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />

    <!--
      Analytics slot. No tracking ships by default.
      Drop your analytics snippet here when ready, for example Plausible:
      <script defer data-domain="yourdomain.com" src="https://plausible.io/js/script.js"></script>
    -->
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

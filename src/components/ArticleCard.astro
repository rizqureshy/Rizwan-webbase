---
import { formatDate } from "../lib/format";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  pillar?: string;
  minutes: number;
}
const { href, title, description, pubDate, pillar, minutes } = Astro.props;
---

<a
  href={href}
  class="glass group flex h-full flex-col rounded-[var(--radius-lg)] p-6 transition-colors hover:border-azure-500/50"
>
  <div class="flex items-center gap-3 text-xs text-text-faint">
    {
      pillar && (
        <span class="rounded-full bg-ink-700 px-2.5 py-1 text-azure-400">
          {pillar}
        </span>
      )
    }
    <span>{minutes} min read</span>
  </div>

  <h3
    class="mt-4 text-lg font-semibold leading-snug transition-colors group-hover:text-azure-400"
  >
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">
    {description}
  </p>

  <div class="mt-5 flex items-center justify-between text-xs text-text-faint">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span
      class="inline-flex items-center gap-1 text-azure-400 transition-transform group-hover:translate-x-0.5"
    >
      Read
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5 12h14M13 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>

---
import { flags } from "../../lib/site";

const links = [
  { href: "/about", label: "About" },
  { href: "/book", label: "Book" },
  { href: "/writing", label: "Writing" },
  ...(flags.speaking ? [{ href: "/speaking", label: "Speaking" }] : []),
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-[var(--max-content)] items-center justify-between px-5 py-4 md:px-8"
  >
    <a
      href="/"
      class="group flex items-center gap-2 text-sm font-semibold tracking-tight"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full bg-azure-500 transition-transform group-hover:scale-125"
        aria-hidden="true"></span>
      Rizwan Qureshy
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "rounded-full px-4 py-2 text-sm transition-colors",
                isActive(l.href)
                  ? "text-white"
                  : "text-text-muted hover:text-text",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile: native details/summary disclosure, zero JS -->
    <details class="relative md:hidden">
      <summary
        class="glass flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full"
        aria-label="Open menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <ul
        class="glass absolute right-0 mt-3 w-44 rounded-[var(--radius-lg)] p-2"
      >
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? "page" : undefined}
                class:list={[
                  "block rounded-[var(--radius-md)] px-4 py-2.5 text-sm",
                  isActive(l.href)
                    ? "bg-ink-700 text-white"
                    : "text-text-muted hover:text-text",
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
